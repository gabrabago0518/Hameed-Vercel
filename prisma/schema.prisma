// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider           = "prisma-client"
  output             = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & addresses ----------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(CUSTOMER)
  // Defaults to true at the column level so existing accounts (created
  // before email verification existed) aren't retroactively locked out —
  // new signups explicitly pass isVerified: false to override this.
  isVerified   Boolean  @default(true)
  // Login rate limiting — incremented on each wrong password, reset to 0 on
  // a successful login. lockedUntil is only ever set once the count crosses
  // the threshold (see lib/loginThrottle.js); a login attempt while locked
  // is rejected without even checking the password, so a lockout can't be
  // used to keep guessing.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  addresses               Address[]
  orders                  Order[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  codVerifications        Payment[]                @relation("CodVerifications")
  orderStatusChanges      OrderStatusHistory[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  // Set once the token has been used to verify the account, so it can't be
  // replayed. Also doubles as "was this ever used" for cleanliness.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("email_verification_tokens")
}

// Mirrors EmailVerificationToken's shape exactly — same single-use,
// expiring-token pattern, just for "set a new password" instead of "confirm
// this email." Kept as its own model rather than reused, since the two
// tokens mean different things and shouldn't be interchangeable (using an
// old verification link to reset a password, or vice versa, should never
// work).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// Signup has no existing user row to attach a failed-attempt counter to
// (unlike login), so it's rate-limited by client IP instead — one row per
// attempt, counted over a sliding window (see lib/signupThrottle.js). Rows
// aren't pruned; at this project's scale that's a non-issue, and a real
// cleanup sweep can be added later if it ever becomes one.
model SignupAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("signup_attempts")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String? // "Home" / "Office" / "Other" — or a custom string typed in for "Other".
  line1      String // street + house/unit number — free text, no dataset to validate against.
  line2      String?
  // City/municipality and barangay are both PSGC-validated (NCR only for
  // now) — the app looks these up against lib/psgc-ncr.json rather than
  // taking free text, so they're plain strings here, not a separate table.
  city       String
  barangay   String?
  landmark   String? // free text, e.g. "Near the church"
  province   String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("addresses")
}

// ---------- Restaurants, branches & menu ----------

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())

  branches       Branch[]
  menuCategories MenuCategory[]

  @@map("restaurants")
}

model Branch {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@map("branches")
}

model MenuCategory {
  id           String @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems  MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  // Distinct from isAvailable: an unavailable item still shows on the menu
  // (greyed out, "Out of Stock") since it might come back in stock later.
  // A retired item is gone from the menu for good (e.g. removed from the
  // lineup during a menu overhaul) but the row itself is kept rather than
  // deleted, since real OrderItem rows may still reference it and deleting
  // it would break that order's history.
  isRetired   Boolean  @default(false)
  createdAt   DateTime @default(now())

  category      MenuCategory       @relation(fields: [categoryId], references: [id])
  addons        ItemAddon[]
  variantGroups ItemVariantGroup[]
  orderItems    OrderItem[]

  @@map("menu_items")
}

// Multi-pick extras with their own price, e.g. "Extra Rice" (+₱25). A
// customer can choose any number of these, or none.
model ItemAddon {
  id         String  @id @default(cuid())
  menuItemId String
  name       String
  price      Decimal @db.Decimal(10, 2)

  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id])
  orderItemAddons OrderItemAddon[]

  @@map("item_addons")
}

// Pick-one choices, e.g. a "Spice Level" group with "Spicy"/"Original"
// options — distinct from ItemAddon (multi-pick) since exactly one option
// must be chosen per group (see ItemVariantGroup.required) rather than any
// number of them.
model ItemVariantGroup {
  id         String  @id @default(cuid())
  menuItemId String
  name       String
  // Every group seeded so far is required (a customer must pick one option
  // before adding the item to their cart) — this exists for a future
  // optional group without needing a schema change to add it.
  required   Boolean @default(true)
  sortOrder  Int     @default(0)

  menuItem MenuItem            @relation(fields: [menuItemId], references: [id])
  options  ItemVariantOption[]

  @@map("item_variant_groups")
}

model ItemVariantOption {
  id         String  @id @default(cuid())
  groupId    String
  name       String
  // Most variant options (like Spicy/Original) don't change the price —
  // defaults to 0 rather than being required, unlike ItemAddon.price.
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  sortOrder  Int     @default(0)

  group               ItemVariantGroup             @relation(fields: [groupId], references: [id])
  orderItemSelections OrderItemVariantSelection[]

  @@map("item_variant_options")
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  // Cash-on-delivery orders only — the manual equivalent of PENDING for a
  // QR/GCash order, except there's no PayMongo intent to poll or webhook to
  // wait for. Staff calling the customer and hitting "Verify" is what moves
  // this to CONFIRMED, the same status a successful PayMongo payment reaches.
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  branchId    String
  // Only set for DELIVERY orders — a PICKUP order has no delivery address.
  addressId   String?
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(10, 2)
  deliveryFee Decimal     @db.Decimal(10, 2)
  // Subtracted from subtotal+deliveryFee to reach total — 0 for the vast
  // majority of orders (no code applied). Kept as a plain amount rather than
  // re-deriving it from the promo code's rule at read time, same reasoning
  // as unitPrice snapshots on OrderItem: a later change to the code (or the
  // code being deleted) must never change what a past order shows it paid.
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  promoCodeId    String?
  total       Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  branch        Branch               @relation(fields: [branchId], references: [id])
  address       Address?             @relation(fields: [addressId], references: [id])
  promoCode     PromoCode?           @relation(fields: [promoCodeId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payment       Payment?
  delivery      OrderDelivery?

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  // Snapshot of MenuItem.price at the moment the order was placed, so a later
  // menu price change never changes the total of a past order.
  unitPrice  Decimal @db.Decimal(10, 2)
  notes      String?

  order             Order                        @relation(fields: [orderId], references: [id])
  menuItem          MenuItem                     @relation(fields: [menuItemId], references: [id])
  addons            OrderItemAddon[]
  variantSelections OrderItemVariantSelection[]

  @@map("order_items")
}

model OrderItemAddon {
  id          String  @id @default(cuid())
  orderItemId String
  addonId     String
  // Snapshot of ItemAddon.price at order time, same reasoning as OrderItem.unitPrice.
  unitPrice   Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  addon     ItemAddon @relation(fields: [addonId], references: [id])

  @@map("order_item_addons")
}

// The pick-one choice actually made for this order item (e.g. "Spicy"),
// same relationship to ItemVariantOption that OrderItemAddon has to
// ItemAddon. priceDelta is snapshotted at order time for the same reason
// OrderItemAddon.unitPrice is; the option's name is read live via the
// variantOption relation rather than also snapshotted, matching
// OrderItemAddon's own choice not to snapshot the addon's name.
model OrderItemVariantSelection {
  id              String  @id @default(cuid())
  orderItemId     String
  variantOptionId String
  priceDelta      Decimal @db.Decimal(10, 2)

  orderItem     OrderItem         @relation(fields: [orderItemId], references: [id])
  variantOption ItemVariantOption @relation(fields: [variantOptionId], references: [id])

  @@map("order_item_variant_selections")
}

// Kept separate from Order.status so the tracking UI can show the full
// timeline (every status the order passed through), not just the current one.
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  // Who made this change, when it was a deliberate staff/admin action (staff
  // clicking "Mark ...", an admin's manual status override, or an admin's COD
  // "Verify"). Left null for automated transitions with no human actor —
  // PayMongo webhook payments, the payment-status poll, or the initial
  // "Order placed" row created at checkout.
  changedByUserId String?
  createdAt DateTime    @default(now())

  order       Order @relation(fields: [orderId], references: [id])
  changedBy   User? @relation(fields: [changedByUserId], references: [id])

  @@map("order_status_history")
}

// ---------- Promotions ----------

enum DiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id     String       @id @default(cuid())
  // Stored and matched uppercase (see lib/promoCode.js) so "welcome10" and
  // "WELCOME10" are the same code from a customer's point of view.
  code   String       @unique
  type   DiscountType
  // PERCENT: a whole number 1-100 (10 = 10% off). FIXED: a peso amount.
  // Same Decimal column either way — which one it means depends on `type`.
  value  Decimal      @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  // Null = unlimited. Checked against usedCount, not a live count of orders
  // referencing this code, so a deleted/refunded order never frees up a slot
  // that was already handed out.
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())

  orders Order[]

  @@map("promo_codes")
}

// ---------- Payments ----------

enum PaymentMethod {
  QR_CODE
  GCASH
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  // Our own human-readable reference, shown to the customer (see HM-XXXXXXXX
  // in app/checkout/actions.js). Independent of anything PayMongo assigns.
  transactionRef String?

  // --- PayMongo fields ---
  // The Payment Intent id (`pi_...`) — this is the key a webhook event uses
  // to tell us which payment it's about, so it must be unique and indexed.
  paymongoPaymentIntentId String? @unique
  // The actual Payment resource id (`pay_...`) once the intent succeeds —
  // distinct from the Payment Intent id above, and the id PayMongo's refund
  // API actually wants (you refund a completed payment, not the intent that
  // led to it). Only ever set once payment.paid fires (from the webhook's
  // event payload) or a poll/sweep reconciliation observes it (from the
  // succeeded intent's own `payments` array) — never set for a still-PENDING
  // payment, since it doesn't exist yet.
  paymongoPaymentId       String? @unique
  // GCash/Maya use a redirect flow: PayMongo hands us a URL, we send the
  // customer there, they authenticate in-app, then get redirected back.
  paymongoCheckoutUrl     String?
  // QRPh instead hands us the QR payload/image directly, to render in place
  // rather than redirecting anywhere.
  paymongoQrCodeData      String?
  // When this Payment Intent's window closes. A PENDING payment past this
  // time gets treated as EXPIRED (checked lazily — see the polling route —
  // there's no cron/scheduler in this project).
  expiresAt               DateTime?

  // --- Cash on Delivery fields ---
  // Set when an admin clicks "Verify" on /admin/orders after calling the
  // customer to confirm — the manual equivalent of a PayMongo webhook firing.
  codVerifiedAt         DateTime?
  codVerifiedByUserId   String?
  codVerifiedBy         User?     @relation("CodVerifications", fields: [codVerifiedByUserId], references: [id])
  // The amount the customer says they'll hand over in cash, collected on the
  // payment step — so whoever delivers/hands off the order knows how much
  // change to bring. Only ever set for CASH_ON_DELIVERY payments.
  codExchangeFor        Decimal?  @db.Decimal(10, 2)

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  // --- Refund fields ---
  // Set once an admin triggers a refund (app/admin/orders/actions.js's
  // refundOrderAction). paymongoRefundId is only set for QR/GCash payments
  // actually refunded through PayMongo's API — a refunded Cash on Delivery
  // payment has no PayMongo transaction to refund at all (the cash was
  // simply never collected, or handed back in person), so it's marked
  // REFUNDED with refundedAt set but paymongoRefundId left null.
  refundedAt       DateTime?
  paymongoRefundId String?

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// Records every PayMongo webhook event we've successfully processed, keyed
// by PayMongo's own event id. A webhook provider can and will redeliver the
// same event more than once — checking this table before acting on an event
// is what makes the webhook handler idempotent (never double-mark an order
// paid or fire fulfillment twice for the same event).
model WebhookEvent {
  id                String   @id @default(cuid())
  provider          String
  providerEventId   String
  type              String
  receivedAt        DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

// ---------- Delivery ----------

model Rider {
  id        String   @id @default(cuid())
  name      String
  phone     String
  vehicle   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries OrderDelivery[]

  @@map("riders")
}

model OrderDelivery {
  id          String    @id @default(cuid())
  orderId     String    @unique
  riderId     String?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  eta         DateTime?

  order Order  @relation(fields: [orderId], references: [id])
  rider Rider? @relation(fields: [riderId], references: [id])

  @@map("order_deliveries")
}
